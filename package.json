{
  "name": "vectormind",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write index.html src README.md package.json eslint.config.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "vite": "^7.1.0",
    "typescript": "^5.9.3",
    "@types/three": "^0.180.0"
  }
}
